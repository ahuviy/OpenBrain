{
  "name": "openbrain",
  "version": "0.7.4",
  "description": "Personal semantic memory system with MCP interface",
  "author": "Scott Nichols",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/srnichols/OpenBrain.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "semantic-search",
    "pgvector",
    "ollama",
    "memory",
    "knowledge-base",
    "ai-tools"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dream": "node dist/cli/dream.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:all": "node scripts/test-all.js",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:db": "vitest run --config vitest.integration.config.ts src/__integration__/dream-port.integration.test.ts",
    "test:provenance": "vitest run --config vitest.integration.config.ts src/__integration__/provenance.test.ts",
    "test:mcp": "vitest run --config vitest.integration.config.ts src/__integration__/http-app.integration.test.ts src/__integration__/oauth.integration.test.ts",
    "test:api": "vitest run --config vitest.integration.config.ts src/__integration__/api.integration.test.ts",
    "fake-embedder": "node scripts/fake-embedder-server.mjs",
    "typecheck": "tsc --noEmit",
    "db:up": "docker run -d --rm --name openbrain-testdb -e POSTGRES_DB=openbrain -e POSTGRES_USER=openbrain -e POSTGRES_PASSWORD=testonly -p 55432:5432 pgvector/pgvector:pg17",
    "db:down": "docker rm -f openbrain-testdb",
    "db:prepare": "docker exec -i openbrain-testdb psql -U openbrain -d openbrain -v ON_ERROR_STOP=1 < db/init.sql && npm run db:migrate",
    "db:migrate": "knex migrate:latest --knexfile knexfile.cjs",
    "db:rollback": "knex migrate:rollback --knexfile knexfile.cjs",
    "db:migrate:status": "knex migrate:list --knexfile knexfile.cjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "hono": "^4.7.0",
    "knex": "^3.3.0",
    "pg": "^8.13.1",
    "pgvector": "^0.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.1"
  }
}
